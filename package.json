{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint:code": "eslint . --ext .js,.mjs,.cjs,.jsx,.ts,.tsx --ignore-pattern \"**/*.mdx\" --max-warnings 0",
    "lint:mdx": "eslint \"content/**/*.mdx\" --max-warnings 0",
    "lint:markdown": "remark . --frail --quiet --ext md --ignore-path .remarkignore",
    "lint:links": "node --import tsx --import ./scripts/register-loaders.mjs scripts/validate-links.ts",
    "lint:docs": "run-s --continue-on-error lint:mdx lint:markdown lint:links",
    "lint": "run-s --continue-on-error lint:code lint:docs",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "run-s --continue-on-error format:check lint types:check"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.4.8",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.4.8",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.4",
    "eslint-plugin-mdx": "^3.8.1",
    "next-validate-link": "^1.6.7",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-lint-first-heading-level": "^4.0.1",
    "remark-lint-heading-increment": "^4.0.1",
    "remark-lint-no-duplicate-headings-in-section": "^4.0.1",
    "remark-lint-no-empty-url": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-lint-no-unused-definitions": "^4.0.2",
    "remark-preset-prettier": "^2.0.2",
    "serve": "^14.2.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
